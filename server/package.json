{
  "name": "claims-register-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext js,json --exec node src/index.js",
    "dev:worker": "nodemon --watch src --ext js,json --exec node src/worker/standalone.js",
    "start": "node src/index.js",
    "start:worker": "node src/worker/standalone.js",
    "build": "node --check src/index.js && node --check src/worker/standalone.js",
    "lint": "eslint .",
    "check": "tsc --project jsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.58.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.7.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "rate-limit-redis": "^4.2.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/hpp": "^0.2.7",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.0",
    "globals": "^16.3.0",
    "nodemon": "^3.1.10",
    "prisma": "6.12.0",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
