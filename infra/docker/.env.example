
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Browser origins allowed to call the API with credentials (comma-separated, no trailing slash).
CLIENT_ORIGINS=claims.example.com,http://localhost:3000

# Public API URL baked into the client image.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1

TRUST_PROXY=1
# lax | strict | none. Use none when the client runs on another site.
COOKIE_SAME_SITE=none

# Used by the demonstration seed to create a default user.
SEED_DEFAULT_PASSWORD=

# Host loopback ports nginx proxies to.
SERVER_PORT=4000
CLIENT_PORT=3000
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

LOG_LEVEL=info
WORKER_CONCURRENCY=4
SESSION_TTL_HOURS=12
DOCUMENT_MAX_BYTES=10485760

# Set all three for Cloudinary, or leave all three empty for the persistent local volume.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
