generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum PartyType {
  PERSON
  ORGANIZATION
}

enum ReserveType {
  INDEMNITY
}

enum ReserveStatus {
  ACTIVE
  REPLACED
  CANCELLED
}

enum ClaimFinancialStatus {
  RESERVED_NOT_SETTLED
  SETTLED_PAYMENT_OUTSTANDING
  SETTLED_AND_PAID
}

enum DocumentType {
  CLAIM_FORM
  POLICE_REPORT
  ID_DOCUMENT
  VEHICLE_DOCUMENT
  LOSS_PHOTO
  ESTIMATE
  INVOICE
  ADJUSTER_REPORT
  PAYMENT_PROOF
  OTHER
}

enum DocumentStatus {
  ACTIVE
  INACTIVE
}

enum StorageProvider {
  LOCAL
  CLOUDINARY
}

enum DocumentCleanupStatus {
  NOT_REQUESTED
  PENDING
  COMPLETED
}

enum PayableType {
  INDEMNITY
  ADJUSTER_FEE
  LEGAL_FEE
  MEDICAL_FEE
  OTHER
}

enum PayableStatus {
  DRAFT
  APPROVED
  CANCELLED
}

enum GLAccountType {
  ASSET
  LIABILITY
  EXPENSE
}

enum JournalSourceType {
  CLAIM_PAYABLE
  CLAIM_PAYMENT
  PAYMENT_REVERSAL
}

enum JournalStatus {
  POSTED
  REVERSED
}

enum SettlementAccountType {
  BANK
  MOBILE_MONEY
  PAYMENT_GATEWAY
  CASH
  OTHER
}

enum PaymentStatus {
  DRAFT
  APPROVED
  PROCESSING
  SUCCESSFUL
  FAILED
  REVERSED
}

enum ExternalTransactionType {
  DEBIT
  CREDIT
}

enum ExternalTransactionSource {
  BANK_STATEMENT
  MOMO_STATEMENT
  GATEWAY_WEBHOOK
  MANUAL_IMPORT
}

enum TransactionImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum ReconciliationStatus {
  UNMATCHED
  PARTIALLY_MATCHED
  MATCHED
}

enum ReconciliationMatchStatus {
  ACTIVE
  REVERSED
}

enum ReconciliationMatchType {
  MANUAL
  AUTO
}

enum ReportExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                 String               @id @default(uuid()) @db.Uuid
  email              String               @unique @db.VarChar(320)
  passwordHash       String               @map("password_hash") @db.VarChar(255)
  firstName          String               @map("first_name") @db.VarChar(100)
  lastName           String               @map("last_name") @db.VarChar(100)
  status             UserStatus           @default(ACTIVE)
  lastLoginAt        DateTime?            @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles              UserRole[]
  sessions           Session[]
  auditLogs          AuditLog[]
  createdParties     Party[]              @relation("PartyCreator")
  createdPolicies    Policy[]             @relation("PolicyCreator")
  createdClaims      Claim[]              @relation("ClaimCreator")
  createdReserves    ClaimReserve[]       @relation("ReserveCreator")
  claimStatusChanges ClaimStatusHistory[] @relation("StatusChanger")
  uploadedDocuments  ClaimDocument[]      @relation("DocumentUploader")
  deactivatedDocuments ClaimDocument[]    @relation("DocumentDeactivator")
  createdPayables ClaimPayable[] @relation("PayableCreator")
  approvedPayables ClaimPayable[] @relation("PayableApprover")
  cancelledPayables ClaimPayable[] @relation("PayableCanceller")
  postedJournals JournalEntry[] @relation("JournalPoster")
  createdPayments ClaimPayment[] @relation("PaymentCreator")
  approvedPayments ClaimPayment[] @relation("PaymentApprover")
  succeededPayments ClaimPayment[] @relation("PaymentSuccessActor")
  reversedPayments ClaimPayment[] @relation("PaymentReverser")
  idempotencyKeys IdempotencyKey[]
  transactionImports TransactionImport[] @relation("TransactionImportActor")
  reconciliationMatches ReconciliationMatch[] @relation("ReconciliationMatcher")
  reversedReconciliationMatches ReconciliationMatch[] @relation("ReconciliationReverser")
  reportExports ReportExport[]

  @@map("users")
}

model Currency {
  code          String         @id @db.Char(3)
  name          String         @db.VarChar(100)
  symbol        String         @db.VarChar(10)
  decimalPlaces Int            @map("decimal_places") @db.SmallInt
  isActive      Boolean        @default(true) @map("is_active")
  policies      Policy[]
  claims        Claim[]
  reserves      ClaimReserve[]
  payables      ClaimPayable[]
  journalEntries JournalEntry[]
  journalLines  JournalLine[]
  settlementAccounts SettlementAccount[]
  paymentCurrencies ClaimPayment[] @relation("PaymentCurrency")
  settlementCurrencies ClaimPayment[] @relation("SettlementCurrency")
  externalTransactions ExternalTransaction[]
  reconciliationMatches ReconciliationMatch[]

  @@map("currencies")
}

model Party {
  id          String       @id @default(uuid()) @db.Uuid
  partyType   PartyType    @map("party_type")
  displayName String       @map("display_name") @db.VarChar(200)
  email       String?      @db.VarChar(320)
  phone       String?      @db.VarChar(50)
  status      RecordStatus @default(ACTIVE)
  createdBy   String       @map("created_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  creator     User         @relation("PartyCreator", fields: [createdBy], references: [id])
  policies    Policy[]
  payables    ClaimPayable[]
  journalLines JournalLine[]
  payments ClaimPayment[]

  @@index([displayName])
  @@index([status, partyType])
  @@map("parties")
}

model Policy {
  id             String       @id @default(uuid()) @db.Uuid
  policyNumber   String       @unique @map("policy_number") @db.VarChar(100)
  policyName     String?      @map("policy_name") @db.VarChar(200)
  insuredPartyId String       @map("insured_party_id") @db.Uuid
  currencyCode   String       @map("currency_code") @db.Char(3)
  effectiveFrom  DateTime?    @map("effective_from") @db.Date
  effectiveTo    DateTime?    @map("effective_to") @db.Date
  status         RecordStatus @default(ACTIVE)
  createdBy      String       @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  insuredParty   Party        @relation(fields: [insuredPartyId], references: [id])
  currency       Currency     @relation(fields: [currencyCode], references: [code])
  creator        User         @relation("PolicyCreator", fields: [createdBy], references: [id])
  claims         Claim[]

  @@index([insuredPartyId])
  @@index([status, currencyCode])
  @@map("policies")
}

model Claim {
  id                         String               @id @default(uuid()) @db.Uuid
  claimNumber                String               @unique @map("claim_number") @db.VarChar(50)
  policyId                   String               @map("policy_id") @db.Uuid
  policyNumberSnapshot       String               @map("policy_number_snapshot") @db.VarChar(100)
  policyNameSnapshot         String?              @map("policy_name_snapshot") @db.VarChar(200)
  insuredNameSnapshot        String               @map("insured_name_snapshot") @db.VarChar(200)
  lossDate                   DateTime             @map("loss_date") @db.Date
  notificationDate           DateTime             @map("notification_date") @db.Date
  notificationOverrideReason String?              @map("notification_override_reason") @db.VarChar(500)
  lossNature                 String               @map("loss_nature") @db.VarChar(150)
  description                String?              @db.VarChar(2000)
  currencyCode               String               @map("currency_code") @db.Char(3)
  createdBy                  String               @map("created_by") @db.Uuid
  createdAt                  DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  policy                     Policy               @relation(fields: [policyId], references: [id])
  currency                   Currency             @relation(fields: [currencyCode], references: [code])
  creator                    User                 @relation("ClaimCreator", fields: [createdBy], references: [id])
  reserves                   ClaimReserve[]
  statusHistory              ClaimStatusHistory[]
  documents                  ClaimDocument[]
  payables                   ClaimPayable[]
  journalEntries             JournalEntry[]
  journalLines               JournalLine[]
  payments                   ClaimPayment[]

  @@index([lossDate])
  @@index([notificationDate])
  @@index([currencyCode, lossDate])
  @@index([policyId])
  @@map("claims")
}

model ClaimReserve {
  id           String        @id @default(uuid()) @db.Uuid
  claimId      String        @map("claim_id") @db.Uuid
  reserveType  ReserveType   @default(INDEMNITY) @map("reserve_type")
  amount       Decimal       @db.Decimal(19, 4)
  currencyCode String        @map("currency_code") @db.Char(3)
  status       ReserveStatus @default(ACTIVE)
  reason       String?       @db.VarChar(500)
  createdBy    String        @map("created_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  claim        Claim         @relation(fields: [claimId], references: [id], onDelete: Restrict)
  currency     Currency      @relation(fields: [currencyCode], references: [code])
  creator      User          @relation("ReserveCreator", fields: [createdBy], references: [id])

  @@index([claimId, status, reserveType])
  @@map("claim_reserves")
}

model ClaimStatusHistory {
  id         String                @id @default(uuid()) @db.Uuid
  claimId    String                @map("claim_id") @db.Uuid
  fromStatus ClaimFinancialStatus? @map("from_status")
  toStatus   ClaimFinancialStatus  @map("to_status")
  reason     String?               @db.VarChar(500)
  changedBy  String                @map("changed_by") @db.Uuid
  changedAt  DateTime              @default(now()) @map("changed_at") @db.Timestamptz(6)
  claim      Claim                 @relation(fields: [claimId], references: [id], onDelete: Restrict)
  changer    User                  @relation("StatusChanger", fields: [changedBy], references: [id])

  @@index([claimId, changedAt])
  @@map("claim_status_history")
}

model ClaimDocument {
  id                 String          @id @default(uuid()) @db.Uuid
  claimId            String          @map("claim_id") @db.Uuid
  documentType       DocumentType    @map("document_type")
  originalFileName   String          @map("original_file_name") @db.VarChar(255)
  storageProvider    StorageProvider @map("storage_provider")
  storageKey         String          @unique @map("storage_key") @db.VarChar(500)
  cloudinaryAssetId  String?         @unique @map("cloudinary_asset_id") @db.VarChar(255)
  cloudinaryPublicId String?         @unique @map("cloudinary_public_id") @db.VarChar(255)
  cloudinaryVersion  String?         @map("cloudinary_version") @db.VarChar(100)
  resourceType       String?         @map("resource_type") @db.VarChar(50)
  format             String?         @db.VarChar(50)
  mimeType           String          @map("mime_type") @db.VarChar(150)
  fileSizeBytes      BigInt          @map("file_size_bytes") @db.BigInt
  providerMetadata   Json?           @map("provider_metadata")
  description        String?         @db.VarChar(500)
  status             DocumentStatus  @default(ACTIVE)
  uploadedBy         String          @map("uploaded_by") @db.Uuid
  uploadedAt         DateTime        @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  deactivatedBy      String?         @map("deactivated_by") @db.Uuid
  deactivatedAt      DateTime?       @map("deactivated_at") @db.Timestamptz(6)
  cleanupStatus      DocumentCleanupStatus @default(NOT_REQUESTED) @map("cleanup_status")
  cleanupAttempts    Int             @default(0) @map("cleanup_attempts")
  cleanupLastError   String?         @map("cleanup_last_error") @db.VarChar(1000)
  cleanupCompletedAt DateTime?       @map("cleanup_completed_at") @db.Timestamptz(6)
  claim              Claim           @relation(fields: [claimId], references: [id], onDelete: Restrict)
  uploader           User            @relation("DocumentUploader", fields: [uploadedBy], references: [id])
  deactivator        User?           @relation("DocumentDeactivator", fields: [deactivatedBy], references: [id])

  @@index([claimId, status, uploadedAt])
  @@index([uploadedBy, uploadedAt])
  @@index([cleanupStatus, deactivatedAt])
  @@map("claim_documents")
}

model ClaimNumberSequence {
  year      Int @id
  nextValue Int @default(1) @map("next_value")

  @@map("claim_number_sequences")
}

model ClaimPayable {
  id String @id @default(uuid()) @db.Uuid
  claimId String @map("claim_id") @db.Uuid
  payeePartyId String @map("payee_party_id") @db.Uuid
  payableType PayableType @default(INDEMNITY) @map("payable_type")
  amount Decimal @db.Decimal(19, 4)
  currencyCode String @map("currency_code") @db.Char(3)
  status PayableStatus @default(DRAFT)
  description String? @db.VarChar(500)
  createdBy String @map("created_by") @db.Uuid
  approvedBy String? @map("approved_by") @db.Uuid
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(6)
  cancelledBy String? @map("cancelled_by") @db.Uuid
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String? @map("cancellation_reason") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  claim Claim @relation(fields: [claimId], references: [id], onDelete: Restrict)
  payee Party @relation(fields: [payeePartyId], references: [id], onDelete: Restrict)
  currency Currency @relation(fields: [currencyCode], references: [code])
  creator User @relation("PayableCreator", fields: [createdBy], references: [id])
  approver User? @relation("PayableApprover", fields: [approvedBy], references: [id])
  canceller User? @relation("PayableCanceller", fields: [cancelledBy], references: [id])
  payments ClaimPayment[]

  @@index([claimId, status, payableType])
  @@index([payeePartyId])
  @@map("claim_payables")
}

model GLAccount {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(50)
  name String @db.VarChar(150)
  accountType GLAccountType @map("account_type")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  lines JournalLine[]
  @@map("gl_accounts")
}

model JournalEntry {
  id String @id @default(uuid()) @db.Uuid
  journalNumber String @unique @map("journal_number") @db.VarChar(50)
  entryDate DateTime @map("entry_date") @db.Date
  sourceType JournalSourceType @map("source_type")
  sourceId String @map("source_id") @db.Uuid
  claimId String @map("claim_id") @db.Uuid
  description String @db.VarChar(500)
  currencyCode String @map("currency_code") @db.Char(3)
  postedBy String @map("posted_by") @db.Uuid
  postedAt DateTime @default(now()) @map("posted_at") @db.Timestamptz(6)
  status JournalStatus @default(POSTED)
  reversalOfEntryId String? @map("reversal_of_entry_id") @db.Uuid
  claim Claim @relation(fields: [claimId], references: [id], onDelete: Restrict)
  currency Currency @relation(fields: [currencyCode], references: [code])
  poster User @relation("JournalPoster", fields: [postedBy], references: [id])
  lines JournalLine[]
  reversalOf JournalEntry? @relation("JournalReversal", fields: [reversalOfEntryId], references: [id], onDelete: Restrict)
  reversals JournalEntry[] @relation("JournalReversal")
  @@unique([sourceType, sourceId])
  @@index([claimId, postedAt])
  @@index([reversalOfEntryId])
  @@map("journal_entries")
}

model JournalLine {
  id String @id @default(uuid()) @db.Uuid
  journalEntryId String @map("journal_entry_id") @db.Uuid
  glAccountId String @map("gl_account_id") @db.Uuid
  claimId String @map("claim_id") @db.Uuid
  partyId String? @map("party_id") @db.Uuid
  currencyCode String @map("currency_code") @db.Char(3)
  debitAmount Decimal @default(0) @map("debit_amount") @db.Decimal(19, 4)
  creditAmount Decimal @default(0) @map("credit_amount") @db.Decimal(19, 4)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  glAccount GLAccount @relation(fields: [glAccountId], references: [id], onDelete: Restrict)
  claim Claim @relation(fields: [claimId], references: [id], onDelete: Restrict)
  party Party? @relation(fields: [partyId], references: [id], onDelete: Restrict)
  currency Currency @relation(fields: [currencyCode], references: [code])
  @@index([journalEntryId])
  @@index([glAccountId])
  @@map("journal_lines")
}

model JournalNumberSequence {
  year Int @id
  nextValue Int @default(1) @map("next_value")
  @@map("journal_number_sequences")
}

model SettlementAccount {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(50)
  name String @db.VarChar(150)
  accountType SettlementAccountType @map("account_type")
  providerName String? @map("provider_name") @db.VarChar(150)
  maskedIdentifier String @map("masked_identifier") @db.VarChar(100)
  currencyCode String @map("currency_code") @db.Char(3)
  status RecordStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  currency Currency @relation(fields: [currencyCode], references: [code])
  payments ClaimPayment[]
  transactionImports TransactionImport[]
  externalTransactions ExternalTransaction[]
  @@index([status, accountType, currencyCode])
  @@map("settlement_accounts")
}

model ClaimPayment {
  id String @id @default(uuid()) @db.Uuid
  paymentNumber String @unique @map("payment_number") @db.VarChar(50)
  claimId String @map("claim_id") @db.Uuid
  payableId String @map("payable_id") @db.Uuid
  payeePartyId String @map("payee_party_id") @db.Uuid
  paymentDate DateTime @map("payment_date") @db.Date
  paymentAmount Decimal @map("payment_amount") @db.Decimal(19, 4)
  paymentCurrencyCode String @map("payment_currency_code") @db.Char(3)
  fxRate Decimal @map("fx_rate") @db.Decimal(20, 8)
  settlementAmount Decimal @map("settlement_amount") @db.Decimal(19, 4)
  settlementCurrencyCode String @map("settlement_currency_code") @db.Char(3)
  settlementAccountId String @map("settlement_account_id") @db.Uuid
  reference String? @db.VarChar(200)
  status PaymentStatus @default(DRAFT)
  createdBy String @map("created_by") @db.Uuid
  approvedBy String? @map("approved_by") @db.Uuid
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(6)
  succeededBy String? @map("succeeded_by") @db.Uuid
  succeededAt DateTime? @map("succeeded_at") @db.Timestamptz(6)
  reversedBy String? @map("reversed_by") @db.Uuid
  reversedAt DateTime? @map("reversed_at") @db.Timestamptz(6)
  reversalReason String? @map("reversal_reason") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  claim Claim @relation(fields: [claimId], references: [id], onDelete: Restrict)
  payable ClaimPayable @relation(fields: [payableId], references: [id], onDelete: Restrict)
  payee Party @relation(fields: [payeePartyId], references: [id], onDelete: Restrict)
  paymentCurrency Currency @relation("PaymentCurrency", fields: [paymentCurrencyCode], references: [code])
  settlementCurrency Currency @relation("SettlementCurrency", fields: [settlementCurrencyCode], references: [code])
  settlementAccount SettlementAccount @relation(fields: [settlementAccountId], references: [id], onDelete: Restrict)
  creator User @relation("PaymentCreator", fields: [createdBy], references: [id])
  approver User? @relation("PaymentApprover", fields: [approvedBy], references: [id])
  successActor User? @relation("PaymentSuccessActor", fields: [succeededBy], references: [id])
  reverser User? @relation("PaymentReverser", fields: [reversedBy], references: [id])
  reconciliationMatches ReconciliationMatch[]
  @@index([payableId, status, paymentDate])
  @@index([claimId, status])
  @@index([settlementAccountId, paymentDate])
  @@map("claim_payments")
}

model TransactionImport {
  id String @id @default(uuid()) @db.Uuid
  sourceType ExternalTransactionSource @map("source_type")
  settlementAccountId String @map("settlement_account_id") @db.Uuid
  sourceFileName String @map("source_file_name") @db.VarChar(255)
  storagePath String @map("storage_path") @db.VarChar(500)
  status TransactionImportStatus @default(PENDING)
  totalRows Int @default(0) @map("total_rows")
  importedRows Int @default(0) @map("imported_rows")
  duplicateRows Int @default(0) @map("duplicate_rows")
  failedRows Int @default(0) @map("failed_rows")
  errorSummary Json? @map("error_summary")
  importedBy String @map("imported_by") @db.Uuid
  importedAt DateTime? @map("imported_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  settlementAccount SettlementAccount @relation(fields: [settlementAccountId], references: [id], onDelete: Restrict)
  importer User @relation("TransactionImportActor", fields: [importedBy], references: [id], onDelete: Restrict)
  transactions ExternalTransaction[]
  @@index([status, createdAt])
  @@index([settlementAccountId, createdAt])
  @@map("transaction_imports")
}

model ExternalTransaction {
  id String @id @default(uuid()) @db.Uuid
  settlementAccountId String @map("settlement_account_id") @db.Uuid
  importId String? @map("import_id") @db.Uuid
  externalReference String @map("external_reference") @db.VarChar(200)
  transactionDate DateTime @map("transaction_date") @db.Date
  valueDate DateTime? @map("value_date") @db.Date
  transactionType ExternalTransactionType @map("transaction_type")
  amount Decimal @db.Decimal(19, 4)
  currencyCode String @map("currency_code") @db.Char(3)
  description String? @db.VarChar(500)
  sourceType ExternalTransactionSource @map("source_type")
  reconciliationStatus ReconciliationStatus @default(UNMATCHED) @map("reconciliation_status")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  settlementAccount SettlementAccount @relation(fields: [settlementAccountId], references: [id], onDelete: Restrict)
  import TransactionImport? @relation(fields: [importId], references: [id], onDelete: Restrict)
  currency Currency @relation(fields: [currencyCode], references: [code])
  matches ReconciliationMatch[]
  @@unique([settlementAccountId, externalReference, transactionDate, amount])
  @@index([settlementAccountId, currencyCode, reconciliationStatus, transactionDate])
  @@index([importId])
  @@map("external_transactions")
}

model ReconciliationMatch {
  id String @id @default(uuid()) @db.Uuid
  paymentId String @map("payment_id") @db.Uuid
  externalTransactionId String @map("external_transaction_id") @db.Uuid
  matchedAmount Decimal @map("matched_amount") @db.Decimal(19, 4)
  currencyCode String @map("currency_code") @db.Char(3)
  status ReconciliationMatchStatus @default(ACTIVE)
  matchType ReconciliationMatchType @default(MANUAL) @map("match_type")
  matchedBy String @map("matched_by") @db.Uuid
  matchedAt DateTime @default(now()) @map("matched_at") @db.Timestamptz(6)
  notes String? @db.VarChar(500)
  reversedBy String? @map("reversed_by") @db.Uuid
  reversedAt DateTime? @map("reversed_at") @db.Timestamptz(6)
  reversalReason String? @map("reversal_reason") @db.VarChar(500)
  payment ClaimPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  externalTransaction ExternalTransaction @relation(fields: [externalTransactionId], references: [id], onDelete: Restrict)
  currency Currency @relation(fields: [currencyCode], references: [code])
  matcher User @relation("ReconciliationMatcher", fields: [matchedBy], references: [id], onDelete: Restrict)
  reverser User? @relation("ReconciliationReverser", fields: [reversedBy], references: [id], onDelete: Restrict)
  @@index([paymentId, status])
  @@index([externalTransactionId, status])
  @@map("reconciliation_matches")
}

model ReportExport {
  id String @id @default(uuid()) @db.Uuid
  reportType String @map("report_type") @db.VarChar(100)
  filters Json
  status ReportExportStatus @default(PENDING)
  filePath String? @map("file_path") @db.VarChar(500)
  fileName String? @map("file_name") @db.VarChar(255)
  rowCount Int @default(0) @map("row_count")
  errorMessage String? @map("error_message") @db.VarChar(1000)
  requestedBy String @map("requested_by") @db.Uuid
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  requester User @relation(fields: [requestedBy], references: [id], onDelete: Restrict)
  @@index([requestedBy, createdAt])
  @@index([status, createdAt])
  @@map("report_exports")
}

model PaymentNumberSequence {
  year Int @id
  nextValue Int @default(1) @map("next_value")
  @@map("payment_number_sequences")
}

model IdempotencyKey {
  id String @id @default(uuid()) @db.Uuid
  scope String @db.VarChar(100)
  key String @db.VarChar(200)
  actorId String @map("actor_id") @db.Uuid
  requestHash String @map("request_hash") @db.Char(64)
  responseCode Int @map("response_code")
  responseBody Json @map("response_body")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([scope, key, actorId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  name        String           @db.VarChar(150)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(150)
  name        String           @db.VarChar(150)
  module      String           @db.VarChar(100)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  assignedAt   DateTime   @default(now()) @map("assigned_at") @db.Timestamptz(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  csrfTokenHash String    @map("csrf_token_hash") @db.Char(64)
  userId        String    @map("user_id") @db.Uuid
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipAddress     String?   @map("ip_address") @db.VarChar(64)
  userAgent     String?   @map("user_agent") @db.VarChar(500)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  action        String   @db.VarChar(150)
  entityType    String   @map("entity_type") @db.VarChar(100)
  entityId      String?  @map("entity_id") @db.Uuid
  oldValues     Json?    @map("old_values")
  newValues     Json?    @map("new_values")
  correlationId String   @map("correlation_id") @db.VarChar(100)
  ipAddress     String?  @map("ip_address") @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.VarChar(500)
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actor         User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([occurredAt])
  @@map("audit_logs")
}
