NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=debug

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/claims_register
REDIS_URL=redis://127.0.0.1:6379

SESSION_COOKIE_NAME=claims_session
CSRF_COOKIE_NAME=claims_csrf
SESSION_TTL_HOURS=12
SEED_DEFAULT_PASSWORD=ChangeMe-DevOnly-123!

CLIENT_ORIGINS=http://localhost:3000
TRUST_PROXY=false
BODY_LIMIT=100kb
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=120

START_EMBEDDED_WORKER=true
WORKER_CONCURRENCY=4

# Leave all three Cloudinary values empty/unset to use server/uploads.
# Partial Cloudinary configuration is rejected during startup.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOCAL_UPLOAD_DIR=uploads
